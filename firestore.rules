rules_version = '2';
// 日向坂樂園 Firestore 安全規則
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // 一個計數 map 只改了一個 key，而且只加減 1、不會變負數
    function oneStep(b, a) {
      let ks = a.diff(b).affectedKeys();
      let k = ks.toList()[0];
      return ks.size() == 1
        && (a.get(k, 0) - b.get(k, 0) == 1 || a.get(k, 0) - b.get(k, 0) == -1)
        && a.get(k, 0) >= 0;
    }
    // 讚的數字要跟「我按過讚」的紀錄同時變動
    function likeOk(b, a) {
      let k = a.diff(b).affectedKeys().toList()[0];
      let p = /databases/$(database)/documents/likes/$(me() + '_' + k);
      return a.get(k, 0) > b.get(k, 0)
        ? (existsAfter(p) && !exists(p))
        : (!existsAfter(p) && exists(p));
    }

    // 使用者自己的資料：暱稱、看過紀錄、收藏的清單
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['nick', 'seen', 'favs', 'at'])
        && request.resource.data.get('nick', '') is string
        && request.resource.data.get('nick', '').size() <= 16
        && request.resource.data.get('favs', []).size() <= 500;
    }

    // 清單
    match /lists/{id} {
      allow get: if true;
      allow list: if resource.data.isPublic == true || (signedIn() && resource.data.owner == me());
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.favs == 0
        && validList(request.resource.data);
      // 作者可以改內容（不能改作者和收藏數）
      allow update: if signedIn() && resource.data.owner == me()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.favs == resource.data.favs
        && validList(request.resource.data);
      // 其他人只能把收藏數加減 1
      allow update: if signedIn()
        && onlyChanged(['favs'])
        && (request.resource.data.favs - resource.data.favs == 1 || request.resource.data.favs - resource.data.favs == -1)
        && request.resource.data.favs >= 0;
      allow delete: if signedIn() && resource.data.owner == me();
    }
    function validList(d) {
      return d.keys().hasOnly(['owner', 'nick', 'name', 'isPublic', 'tags', 'items', 'favs', 'at', 'upd'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.nick is string && d.nick.size() <= 16
        && d.isPublic is bool
        && d.tags is list && d.tags.size() <= 3
        && d.items is list && d.items.size() <= 200;
    }

    // 各園區的讚、收藏數、留言數
    match /stats/{area} {
      allow read: if true;
      allow create: if signedIn() && area in ['R', 'H', 'M']
        && request.resource.data.keys().hasOnly(['likes', 'adds', 'cmts'])
        && request.resource.data.likes.size() == 0
        && request.resource.data.adds.size() == 0
        && request.resource.data.cmts.size() == 0;
      allow update: if signedIn() && (
        (onlyChanged(['likes']) && oneStep(resource.data.likes, request.resource.data.likes) && likeOk(resource.data.likes, request.resource.data.likes))
        || (onlyChanged(['adds']) && oneStep(resource.data.adds, request.resource.data.adds))
        || (onlyChanged(['cmts']) && oneStep(resource.data.cmts, request.resource.data.cmts))
      );
    }

    // 我按過讚的集數（一人一集一筆）
    match /likes/{id} {
      allow read: if signedIn() && resource.data.uid == me();
      allow create: if signedIn() && request.resource.data.uid == me()
        && id == me() + '_' + request.resource.data.key
        && request.resource.data.keys().hasOnly(['uid', 'key', 'at']);
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // 留言
    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['ep', 'uid', 'nick', 'text', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 140
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 16;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // 檢舉（只能送出，站長在主控台看）
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['cid', 'why', 'more', 'uid', 'at'])
        && request.resource.data.more is string && request.resource.data.more.size() <= 200;
    }
  }
}
